{
  "displayName": "ClickFix",
  "name": "clickFix",
  "group": [
    "transform"
  ],
  "version": 1,
  "description": "Organization-scoped ClickFix support actions and REST hook subscriptions",
  "defaults": {
    "name": "ClickFix"
  },
  "inputs": [
    "main"
  ],
  "outputs": [
    "main"
  ],
  "credentials": [
    {
      "name": "clickFixApi",
      "required": true
    }
  ],
  "requestDefaults": {
    "baseURL": "={{$credentials.baseUrl + \"/v1/public-api\"}}",
    "headers": {
      "Accept": "application/json",
      "Content-Type": "application/json"
    }
  },
  "properties": [
    {
      "displayName": "Operation",
      "name": "operation",
      "type": "options",
      "noDataExpression": true,
      "default": "createConversation",
      "options": [
        {
          "name": "Create Conversation",
          "value": "createConversation",
          "action": "create conversation",
          "routing": {
            "request": {
              "method": "POST",
              "url": "/conversations",
              "headers": {
                "Idempotency-Key": "={{$parameter[\"idempotencyKey\"]}}"
              },
              "body": "={{$parameter[\"body\"]}}"
            }
          }
        },
        {
          "name": "Add Note",
          "value": "addNote",
          "action": "add note",
          "routing": {
            "request": {
              "method": "POST",
              "url": "=/conversations/{{$parameter[\"recordUuid\"]}}/messages",
              "headers": {
                "Idempotency-Key": "={{$parameter[\"idempotencyKey\"]}}"
              },
              "body": "={{$parameter[\"body\"]}}"
            }
          }
        },
        {
          "name": "Update Contact",
          "value": "updateContact",
          "action": "update contact",
          "routing": {
            "request": {
              "method": "PATCH",
              "url": "=/contacts/{{$parameter[\"recordUuid\"]}}",
              "headers": {
                "Idempotency-Key": "={{$parameter[\"idempotencyKey\"]}}"
              },
              "body": "={{$parameter[\"body\"]}}"
            }
          }
        },
        {
          "name": "Subscribe Trigger",
          "value": "subscribe",
          "action": "subscribe trigger",
          "routing": {
            "request": {
              "method": "POST",
              "url": "/subscriptions",
              "headers": {
                "Idempotency-Key": "={{$parameter[\"idempotencyKey\"]}}"
              },
              "body": "={{$parameter[\"body\"]}}"
            }
          }
        },
        {
          "name": "Unsubscribe Trigger",
          "value": "unsubscribe",
          "action": "unsubscribe trigger",
          "routing": {
            "request": {
              "method": "DELETE",
              "url": "=/subscriptions/{{$parameter[\"recordUuid\"]}}",
              "headers": {
                "Idempotency-Key": "={{$parameter[\"idempotencyKey\"]}}"
              }
            }
          }
        },
        {
          "name": "Poll Triggers",
          "value": "poll",
          "action": "poll triggers",
          "routing": {
            "request": {
              "method": "GET",
              "url": "/triggers"
            }
          }
        }
      ]
    },
    {
      "displayName": "Idempotency Key",
      "name": "idempotencyKey",
      "type": "string",
      "default": "",
      "required": true,
      "description": "Stable per logical action; preserve on retries",
      "displayOptions": {
        "hide": {
          "operation": [
            "poll"
          ]
        }
      }
    },
    {
      "displayName": "Record UUID",
      "name": "recordUuid",
      "type": "string",
      "default": "",
      "required": true,
      "displayOptions": {
        "show": {
          "operation": [
            "addNote",
            "updateContact",
            "unsubscribe"
          ]
        }
      }
    },
    {
      "displayName": "JSON Body",
      "name": "body",
      "type": "json",
      "default": "{}",
      "required": true,
      "description": "For Add Note: {\"content\":\"Internal context\",\"private\":true,\"client_id\":\"UUID\"}",
      "displayOptions": {
        "show": {
          "operation": [
            "createConversation",
            "addNote",
            "updateContact",
            "subscribe"
          ]
        }
      }
    },
    {
      "displayName": "Event",
      "name": "event",
      "type": "options",
      "default": "conversation.created",
      "options": [
        {
          "name": "conversation.created",
          "value": "conversation.created"
        },
        {
          "name": "conversation.resolved",
          "value": "conversation.resolved"
        },
        {
          "name": "contact.created",
          "value": "contact.created"
        },
        {
          "name": "csat.submitted",
          "value": "csat.submitted"
        },
        {
          "name": "conversation.tag_added",
          "value": "conversation.tag_added"
        }
      ],
      "displayOptions": {
        "show": {
          "operation": [
            "poll"
          ]
        }
      },
      "routing": {
        "request": {
          "qs": {
            "event": "={{$value}}"
          }
        }
      }
    },
    {
      "displayName": "Cursor",
      "name": "cursor",
      "type": "string",
      "default": "0",
      "description": "Persist data.next_cursor after successful handling; deduplicate data.items by id",
      "displayOptions": {
        "show": {
          "operation": [
            "poll"
          ]
        }
      },
      "routing": {
        "request": {
          "qs": {
            "cursor": "={{$value}}"
          }
        }
      }
    }
  ]
}
