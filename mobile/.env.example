# Origin the app calls under, with a Bearer token: <origin>/v1/... is the Go API.
# Production (through the Next.js BFF passthrough): https://<panel host>/api/mobile
# Local, BFF:                         http://localhost:3000/api/mobile
# Local, Go directly (device on LAN): http://<LAN IP of your computer>:8080
EXPO_PUBLIC_API_URL=http://localhost:3000/api/mobile
# Panel origin: "forgot password", legal pages and QR sign-in links.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
# Optional: Centrifugo socket, when the API's CENTRIFUGO_WS_URL is not reachable from phones.
# EXPO_PUBLIC_REALTIME_URL=wss://rt.<panel host>/connection/websocket
