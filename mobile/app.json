{
  "expo": {
    "name": "ClickFix",
    "slug": "clickfix",
    "owner": "getclickfix",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clickfix",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.getclickfix.app",
      "appleTeamId": "42UJB2ZNC5",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "ClickFix, web panelinde oturum açmak için QR kodu taramak, müşteriye fotoğraf göndermek ve görüntülü görüşme yapmak için kamerayı kullanır.",
        "NSMicrophoneUsageDescription": "ClickFix, görüntülü görüşmelerde sesinizin karşı tarafa iletilmesi için mikrofonu kullanır.",
        "UIBackgroundModes": [
          "audio"
        ]
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1",
              "1C8F.1"
            ]
          }
        ],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeName",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhoneNumber",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeAudioData",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          },
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": true,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ]
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.getclickfix.app",
      "adaptiveIcon": {
        "backgroundColor": "#03FF13",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET"
      ]
    },
    "locales": {
      "tr": "./assets/locales/tr.json",
      "en": "./assets/locales/en.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 88,
          "dark": {
            "backgroundColor": "#0A0D0B",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "tr",
            "en"
          ]
        }
      ],
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#000000",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ClickFix, web panelinde oturum açmak için QR kodu taramak, müşteriye fotoğraf göndermek ve görüntülü görüşme yapmak için kamerayı kullanır.",
          "microphonePermission": "ClickFix, görüntülü görüşmelerde sesinizin karşı tarafa iletilmesi için mikrofonu kullanır.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "ClickFix, görüntülü görüşmelerde sesinizin karşı tarafa iletilmesi için mikrofonu kullanır.",
          "recordAudioAndroid": true,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ClickFix, konuşmalara fotoğraf eklemeniz için fotoğraf arşivinize erişir.",
          "cameraPermission": "ClickFix, web panelinde oturum açmak için QR kodu taramak, müşteriye fotoğraf göndermek ve görüntülü görüşme yapmak için kamerayı kullanır.",
          "microphonePermission": "ClickFix, görüntülü görüşmelerde sesinizin karşı tarafa iletilmesi için mikrofonu kullanır."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "ClickFix, uygulama kilidini Face ID ile açmanız için Face ID kullanır."
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "ClickFix, web panelinde oturum açmak için QR kodu taramak, müşteriye fotoğraf göndermek ve görüntülü görüşme yapmak için kamerayı kullanır.",
          "microphonePermission": "ClickFix, görüntülü görüşmelerde sesinizin karşı tarafa iletilmesi için mikrofonu kullanır."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "ClickFix, telefonu sallayarak geri bildirim göndermeniz için hareket sensörünü kullanır."
        }
      ],
      "./plugins/with-clickfix-surfaces",
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Inbox",
              "label": "ClickFix",
              "description": "Okunmamış ve bana atanan konuşmalar",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "maxResizeWidth": "420dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Presence",
              "label": "ClickFix",
              "description": "Durumum: çevrimiçi, uzakta, meşgul",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/27090ce5-f699-441d-9423-33b82417d300"
    },
    "extra": {
      "eas": {
        "projectId": "27090ce5-f699-441d-9423-33b82417d300"
      }
    }
  }
}
