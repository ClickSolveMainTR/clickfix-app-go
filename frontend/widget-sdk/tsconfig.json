{
  "compilerOptions": {
    "target": "ES2018",
    "lib": ["dom", "dom.iterable", "es2018", "es2019", "es2020"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
