# Copy to .env for local/host development.
# compose.local.yml supplies service DNS to containers; host apps use 127.0.0.1.
# For production, copy to .env.server and replace every secret before make prod-config.

# --- Identity / naming (set before first deploy; services share hosts) ---
NAME_PREFIX=clickfix
COMPOSE_PROJECT_NAME=app
LOCAL_NETWORK_NAME=app
APP_NETWORK_NAME=app-app
POSTGRES_VOLUME_NAME=clickfix-postgres
REDIS_VOLUME_NAME=clickfix-redis
SEAWEEDFS_VOLUME_NAME=clickfix-seaweedfs
MEILI_VOLUME_NAME=clickfix-meilisearch
BACKEND_IMAGE=app-backend:local
FRONTEND_IMAGE=app-frontend:local


# --- App ---
APP_NAME=api
APP_ENV=development
APP_HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=json

# --- Postgres (host → published port) ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=app
DB_PASSWORD=change_me
DB_NAME=app
DB_SSLMODE=disable
POSTGRES_PORT=5432

# --- Redis ---
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# --- Object storage (SeaweedFS, S3 API) ---
# The bucket is private (no anonymous access). Browsers never reach storage:
# the API streams every object (logo_url / public_url / downloads).
STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=s3admin
S3_SECRET_KEY=s3admin-secret
S3_BUCKET=app
S3_REGION=us-east-1
S3_USE_PATH_STYLE=true
S3_PORT=9000
# Sign SeaweedFS filer / volume traffic so only its S3 gateway can read or
# write objects (openssl rand -hex 32; required in production).
SEAWEEDFS_JWT_WRITE_KEY=local-seaweedfs-write-key
SEAWEEDFS_JWT_READ_KEY=local-seaweedfs-read-key

# --- Attachments (organization files; /v1/tenant/attachments) ---
# Defaults until the plan/entitlement module supplies per-plan limits.
ATTACHMENT_MAX_FILE_BYTES=26214400
ATTACHMENT_ORG_QUOTA_BYTES=5368709120
ATTACHMENT_SIGNED_URL_TTL=5m

# --- Centrifugo ---
CENTRIFUGO_ENABLED=true
CENTRIFUGO_PORT=8000
CENTRIFUGO_API_URL=http://127.0.0.1:8000
CENTRIFUGO_API_KEY=app-centrifugo-api-key-change-me
CENTRIFUGO_TOKEN_HMAC_SECRET=app-centrifugo-token-hmac-change-me
CENTRIFUGO_WS_URL=ws://127.0.0.1:8000/connection/websocket
CENTRIFUGO_TOKEN_TTL=1h
CENTRIFUGO_ALLOWED_ORIGINS=http://localhost:3000 http://127.0.0.1:3000

# --- JWT ---
JWT_ACCESS_SECRET=app-dev-access-secret-change-me-32b
JWT_REFRESH_SECRET=app-dev-refresh-secret-change-me-32b
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# --- Mail (MailHog locally; production MAIL_FROM=noreply@getclickfix.com) ---
MAIL_DRIVER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=noreply@localhost
SMTP_FROM=noreply@localhost
MAIL_FROM_NAME=ClickFix
# starttls (plain connect, upgrade when offered) or implicit (TLS from the
# first byte, SMTPS on 465).
SMTP_TLS_MODE=starttls
# When the primary port cannot be reached (egress on 587 blocked), retry once
# with implicit TLS on this port (usually 465). 0 = off.
SMTP_FALLBACK_PORT=0
# TCP connect timeout and whole-session timeout per message.
SMTP_DIAL_TIMEOUT=10s
SMTP_SEND_TIMEOUT=30s
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
ADMINER_PORT=8081

# --- Search (Meilisearch) ---
SEARCH_ENABLED=true
SEARCH_DRIVER=meilisearch
MEILI_HOST=http://127.0.0.1:7700
MEILI_MASTER_KEY=app-dev-meili-master-key-change-me
MEILI_INDEX_PREFIX=app
MEILI_PORT=7700

# --- Queue ---
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=10
# Empty: all existing queues + sync (single-worker local development).
# Production worker defaults exclude sync; optional weights: default:6,critical:10.
QUEUE_QUEUES=
# Exactly one worker service owns schedules. Disable on consumer replicas.
QUEUE_SCHEDULER_ENABLED=true
# Production worker-sync concurrency (independent of the main worker).
QUEUE_SYNC_CONCURRENCY=4

# Bulk action engine
BULK_SYNC_MAX=50
BULK_ROLLBACK_HOURS=24
QUEUE_WORKER_INPROCESS=true

# --- Tenancy (organizations; docs/design/tenant-core.md) ---
# ClickFix is always multi-tenant: keep true (false drops every /v1/tenant route).
TENANCY_ENABLED=true
# Self-serve sign-up is a platform setting (Platform → Ayarlar → Giriş ve kayıt: açık / davetle / kapalı).
# One-time AI credit allowance (1 credit ≈ 1000 tokens, valid 30 days) for the
# AI-assisted set-up of a self-serve organization (CF-140); 0 turns it off.
ONBOARDING_AI_CREDITS=40
# Redis cache for org + membership lookups; changes invalidate it at once.
TENANCY_CACHE_TTL=60s
# Lifetime of a staff invitation link.
TENANCY_INVITE_TTL=168h

# --- CORS / public URLs ---
# Production (docs/DEVELOPMENT.md "Yayınlama"): app + marketing https://getclickfix.com,
# API https://api.getclickfix.com, widget/CDN https://widget.getclickfix.com,
# mail noreply@getclickfix.com / destek@getclickfix.com. The values below are local dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:8080
PUBLIC_FRONTEND_URL=http://localhost:3000
# BFF upstream base — must include /v1 (Go routes are /v1/...).
API_URL=http://127.0.0.1:8080/v1

# --- At-rest secret encryption (GitHub App credentials in DB) ---
# 32-byte key, raw or base64. Generate: openssl rand -base64 32
# The backend refuses to start outside development with this example value.
APP_ENCRYPTION_KEY=app-dev-encryption-key-32bytes!!

# --- NextAuth (frontend session layer) ---
AUTH_SECRET=app-dev-auth-secret-change-me-32chars-min
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_ADAPTER_SECRET=app-dev-auth-adapter-secret-change-me

# --- Mobile auth (backend) ---
# App Store / Play review accounts: comma-separated email:code (code >= 6 chars).
# The fixed code signs in (and confirms account deletion) for that email only;
# no email is sent. Leave empty to disable. See backend/docs/auth.md.
AUTH_REVIEW_ACCOUNTS=
# Accepted id_token audiences for native sign-in (comma-separated).
AUTH_APPLE_NATIVE_CLIENT_IDS=
# Google iOS + Android OAuth client ids; the web client id from OAuth settings is accepted too.
AUTH_GOOGLE_NATIVE_CLIENT_IDS=
# Sign in with Apple key (.p8) for code exchange + token revocation on account deletion.
# Optional fallback: prefer uploading the .p8 in Platform → Integrations → Apple
# (stored encrypted in the DB; it wins over these and also generates the web
# client secret). AUTH_APPLE_PRIVATE_KEY is the PEM; "\n" escapes are accepted on one line.
AUTH_APPLE_TEAM_ID=
AUTH_APPLE_KEY_ID=
AUTH_APPLE_PRIVATE_KEY=

# --- QR sign-in (web QR approved from the mobile app) ---
# Approximate location shown on the phone. Trust edge geo headers (CF-IPCountry /
# CF-IPCity / CF-Region) ONLY behind Cloudflare with "Add visitor location headers"
# on; otherwise a phisher could fake them. Optional MaxMind GeoLite2-City .mmdb path
# as fallback. Neither set = the app shows the IP only. Needs Centrifugo (namespace
# "qrlogin" in deploy/centrifugo/config*.json).
AUTH_QR_TRUST_GEO_HEADERS=false
AUTH_QR_GEOIP_DB=
# Passkey RP ID; defaults to the hostname of PUBLIC_FRONTEND_URL.
AUTH_WEBAUTHN_RP_ID=localhost

# --- Frontend public (baked into the browser bundle) ---
NEXT_PUBLIC_BFF_BASE_URL=/api
NEXT_PUBLIC_REALTIME_ENABLED=true
NEXT_PUBLIC_CENTRIFUGO_URL=ws://127.0.0.1:8000/connection/websocket
NEXT_PUBLIC_DEFAULT_LOCALE=tr
NEXT_PUBLIC_FALLBACK_LOCALE=en

# --- Web Push (VAPID). Required for closed-browser notifications. ---
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:destek@getclickfix.com

# --- APNs (iOS Live Activity push, CF-152). Empty = Live Activity push off. ---
# developer.apple.com → Keys → APNs key (.p8). APNS_PRIVATE_KEY is the .p8
# content base64-encoded (`base64 -w0 AuthKey_XXXX.p8`); raw PEM also works.
# APNS_TOPIC is the iOS bundle id (default com.getclickfix.app).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=com.getclickfix.app

# --- Error tracking (Sentry protocol) — all optional ---
# Empty DSN = reporting off, nothing else changes. No auth token here: source
# maps are uploaded only by CI (SENTRY_AUTH_TOKEN Actions secret, CF-227).
# Production (compose.prod.yml / Dokploy shares one env across services):
#   BACKEND_SENTRY_DSN  → backend API + worker (as SENTRY_DSN)
#   FRONTEND_SENTRY_DSN → Next.js server, edge and browser (as SENTRY_DSN)
#   SENTRY_ENVIRONMENT  → both (compose default: production)
BACKEND_SENTRY_DSN=
FRONTEND_SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Backend only: share of HTTP requests traced (0..1, e.g. 0.1). 0 = off.
SENTRY_TRACES_SAMPLE_RATE=0
# Local dev (no compose): the apps read SENTRY_DSN directly. Empty = off.
SENTRY_DSN=

# --- Channels (CF-55..CF-61) ---------------------------------------------------
# E-mail channel: Resend receiving domain (MX at Resend) + sending key.
# Production: in.getclickfix.com
EMAIL_INBOUND_DOMAIN=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_BASE_URL=https://api.resend.com
# Meta channels (WhatsApp / Instagram / Messenger). Off until the Meta app review passes.
META_CHANNELS_ENABLED=false
META_APP_ID=
# Account erasure grace. Signing in never cancels deletion; support only.
AUTH_ACCOUNT_DELETION_GRACE=168h
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_CONFIG_ID=
META_GRAPH_VERSION=v21.0
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_RECONCILE_INTERVAL=1m
META_RECONCILE_WINDOW=3h
TELEGRAM_CHANNEL_ENABLED=true
CHANNEL_HEALTH_INTERVAL=15m

# --- Billing (CF-18..CF-42) ---------------------------------------------------
# Seller identity printed on every invoice (one-line JSON, no quotes: the
# Makefile loader exports values verbatim). Required: without it no invoice can
# be created, so "pay now", havale/EFT and renewals fail with
# PAYMENT_GATEWAY_NOT_CONFIGURED. The value below is a local sample (test VKN);
# production uses the real company record, set in Dokploy.
BILLING_SELLER_JSON={"kind":"company","legal_name":"ClickFix Yazilim (ornek)","tax_id":"1234567890","tax_office":"Kadikoy","country_code":"TR","address":{"street":"Ornek Cad. No:1","district":"Kadikoy","city":"Istanbul","postal_code":"34710"},"emails":["fatura@example.com"]}
# e-Arşiv/e-Fatura provider: empty = off, fake = local stub (development/test only).
BILLING_EINVOICE_PROVIDER=
# Three upper-case letters (default CFX).
BILLING_INVOICE_SERIES=
# AI credits granted per redeemed referral code (empty = referral redemption off).
BILLING_REFERRAL_CREDITS=
# Payment providers. Credentials come only from env (never the API). MODE is sandbox (default) or live.
# ACCOUNT_UUID is optional: empty = derived from provider+mode+merchant; set it to keep history when
# changing merchant. PayTR: Mağaza Paneli → Bilgi → API Entegrasyon Bilgileri.
# iyzico: merchant.iyzipay.com (or sandbox-merchant.iyzipay.com) → Ayarlar → Firma Ayarları → API anahtarları.
PAYMENTS_PAYTR_ENABLED=false
PAYMENTS_PAYTR_MODE=sandbox
PAYMENTS_PAYTR_MERCHANT_ID=
PAYMENTS_PAYTR_MERCHANT_KEY=
PAYMENTS_PAYTR_MERCHANT_SALT=
PAYMENTS_PAYTR_ACCOUNT_UUID=
PAYMENTS_IYZICO_ENABLED=false
PAYMENTS_IYZICO_MODE=sandbox
PAYMENTS_IYZICO_API_KEY=
PAYMENTS_IYZICO_SECRET_KEY=
PAYMENTS_IYZICO_ACCOUNT_UUID=
# iyzico settlement statement import (default on when an iyzico account exists).
PAYMENTS_IYZICO_STATEMENTS_ENABLED=
# Optional comma-separated CIDRs allowed to call the provider webhooks. Empty (default) = any source;
# the HMAC signature is always required. See docs/odeme.md.
PAYMENTS_PAYTR_WEBHOOK_CIDRS=
PAYMENTS_IYZICO_WEBHOOK_CIDRS=
# Reverse proxy CIDRs (e.g. the Traefik/Dokploy network) whose X-Forwarded-For is trusted when the
# webhook CIDR lists above are enforced. Empty = the TCP peer is the source.
PAYMENTS_TRUSTED_PROXY_CIDRS=

# --- AI providers (backend/docs/ai/CORE-G3.md) ---------------------------------
# Empty key = that provider is off. OPENAI_BASE_URL defaults to https://api.openai.com/v1.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
AI_TRANSCRIBE_MODEL=
AI_TRANSCRIBE_PRICE_MICROS=
AI_TRANSCRIBE_SUMMARY=false
# One embedding model for every stored vector (CF-214). Empty = text-embedding-3-small.
# It must return 1536 dimensions (text-embedding-3-* models are asked for 1536). Changing it
# re-embeds every vector in the background (charged to each organization's AI credits);
# search keeps the old vectors until an organization is fully switched.
AI_EMBEDDING_MODEL=
# Prices in USD micro-units per 1M tokens ($1 = 1000000). A task with no price stays OFF:
# zero cost would bypass budgets (backend/internal/aisystem/system.go). Tasks and default models:
# TRIAGE claude-haiku-5-5, REPLY claude-sonnet-5-5, COMPLEX claude-opus-5-5 (Anthropic list prices
# on 2026-10-28: haiku 100000/500000, sonnet 2000000/10000000, opus 4000000/20000000 in/out).
# AI_<TASK>_PROVIDER=openai switches a task to OpenAI with AI_<TASK>_MODEL. FALLBACK_* adds an
# OpenAI failover model for an Anthropic task (needs OPENAI_API_KEY and both fallback prices).
AI_TRIAGE_PROVIDER=
AI_TRIAGE_MODEL=
AI_TRIAGE_INPUT_PRICE_MICROS=
AI_TRIAGE_OUTPUT_PRICE_MICROS=
# Optional cache prices; unset uses the effective input price above.
AI_TRIAGE_CACHE_READ_PRICE_MICROS=
AI_TRIAGE_CACHE_CREATE_PRICE_MICROS=
AI_TRIAGE_FALLBACK_MODEL=
AI_TRIAGE_FALLBACK_INPUT_PRICE_MICROS=
AI_TRIAGE_FALLBACK_OUTPUT_PRICE_MICROS=
AI_REPLY_PROVIDER=
AI_REPLY_MODEL=
AI_REPLY_INPUT_PRICE_MICROS=
AI_REPLY_OUTPUT_PRICE_MICROS=
# Optional cache prices; unset uses the effective input price above.
AI_REPLY_CACHE_READ_PRICE_MICROS=
AI_REPLY_CACHE_CREATE_PRICE_MICROS=
AI_REPLY_FALLBACK_MODEL=
AI_REPLY_FALLBACK_INPUT_PRICE_MICROS=
AI_REPLY_FALLBACK_OUTPUT_PRICE_MICROS=
AI_COMPLEX_PROVIDER=
AI_COMPLEX_MODEL=
AI_COMPLEX_INPUT_PRICE_MICROS=
AI_COMPLEX_OUTPUT_PRICE_MICROS=
# Optional cache prices; unset uses the effective input price above.
AI_COMPLEX_CACHE_READ_PRICE_MICROS=
AI_COMPLEX_CACHE_CREATE_PRICE_MICROS=
AI_COMPLEX_FALLBACK_MODEL=
AI_COMPLEX_FALLBACK_INPUT_PRICE_MICROS=
AI_COMPLEX_FALLBACK_OUTPUT_PRICE_MICROS=
# Embeddings (knowledge base search) need an OpenAI-compatible key, AI_EMBEDDING_MODEL and this price.
AI_EMBEDDING_INPUT_PRICE_MICROS=
# Slack channel OAuth app (per-organization workspace installs).
SLACK_CHANNEL_CLIENT_ID=
SLACK_CHANNEL_CLIENT_SECRET=
SLACK_CHANNEL_SIGNING_SECRET=
SLACK_CHANNEL_REDIRECT_URL=
# Organization IP policies: only trust actual BFF/reverse proxy networks.
# Empty = use direct TCP peer, ignore X-Forwarded-For.
SSO_TRUSTED_PROXY_CIDRS=
# Video rooms (CF-139, docs/video-rooms.md). Local values match compose.local.yml's
# livekit service; empty keys leave the module "not configured".
# LIVEKIT_URL is what browsers / phones dial (prod: wss://video.<domain>).
LIVEKIT_URL=ws://localhost:7880
# Server-to-server API (prod: compose sets http://livekit.<app network>:7880).
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=APIclickfixdev
# At least 32 characters (LiveKit rejects shorter secrets).
LIVEKIT_API_SECRET=clickfix-local-livekit-secret-change-me
# SeaweedFS as the egress container reaches it (prod: compose sets it).
VIDEO_APPOINTMENT_OPEN_BEFORE_MINUTES=10
VIDEO_APPOINTMENT_GRACE_MINUTES=15
VIDEO_EGRESS_S3_ENDPOINT=http://seaweedfs:8333
# Prod-only LiveKit tuning (compose.prod.yml livekit service; not read by the API):
# LIVEKIT_TURN_DOMAIN=turn.<domain>  LIVEKIT_NODE_IP=  LIVEKIT_RTC_PORT_START=50000  LIVEKIT_RTC_PORT_END=50100
