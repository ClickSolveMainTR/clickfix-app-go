{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClickFix Destek",
  "mainBinaryName": "clickfix-support",
  "version": "0.1.0",
  "identifier": "com.getclickfix.support",
  "build": {
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "node ../../scripts/build-sidecar.mjs && pnpm dev",
    "beforeBuildCommand": "node ../../scripts/build-sidecar.mjs && pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis"],
    "category": "Utility",
    "shortDescription": "ClickFix hızlı destek",
    "externalBin": ["binaries/clickfix-sidecar"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://getclickfix.com/api/v1/public/desktop/releases/support/{{target}}-{{arch}}/{{current_version}}?channel=stable"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
